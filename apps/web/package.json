		"react-resizable-panels": "^2.1.7",
		"react-router": "^7.6.0",
		"react-router-dom": "^7.6.0",
		"react-router-hono-server": "^2.13.0",
		"recharts": "^2.12.0",
		"remark-gfm": "4.0.0",
